# Choose openai or openrouter. Runs never fall back to simulation.
AI_PROVIDER=openrouter
AI_MAX_OUTPUT_TOKENS=300
AI_REASONING_EFFORT=low

# Direct OpenAI configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter configuration. The model must support image input and tool calling.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME="Greenhouse Lockdown"

SITE_URL=http://localhost:3000

# Optional MLflow server. Leave blank to use only the embedded sanitized viewer.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME="AI Escape Room"
MLFLOW_EXPERIMENT_ID=
