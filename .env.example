# Choose openai or openrouter. Runs never fall back to simulation.
AI_PROVIDER=openrouter
AI_MAX_OUTPUT_TOKENS=300
AI_REASONING_EFFORT=low

# Direct OpenAI configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter configuration. The model must support image input and tool calling.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME="Prompt Lab"

SITE_URL=http://localhost:3000

# Shared workshop gateway. GATEWAY_ALLOWED_IPS is a comma-separated list of
# exact IPv4 or IPv6 addresses that may bypass the cookie check.
GATEWAY_ACCESS_CODE=women-in-tech-shape-the-future
GATEWAY_ALLOWED_IPS=

# MLflow server used for workshop traces.
MLFLOW_TRACKING_URI=
MLFLOW_PUBLIC_URL=http://127.0.0.1:5050
MLFLOW_EXPERIMENT_NAME="Prompt Lab"
MLFLOW_EXPERIMENT_ID=

# EC2 deployment. The generator creates one app and one MLflow service per
# participant. Traefik serves each private MLflow service at the app's
# same-host /mlflow path, so Cloudflare only needs participant app DNS.
DEPLOY_DOMAIN=botanica.tools
PARTICIPANT_COUNT=50
CLOUDFLARE_TUNNEL_TOKEN=
APP_IMAGE=greenhouse-app:local
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.10.0
TRAEFIK_IMAGE=traefik:v3.5
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
APP_MEMORY_LIMIT=256m
MLFLOW_MEMORY_LIMIT=512m
